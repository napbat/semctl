{
  "description": "Shared semctx retrieval context for supported coding agents.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "semctl hook",
            "timeout": 8,
            "statusMessage": "Loading semctx repository context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "semctl hook",
            "timeout": 12,
            "statusMessage": "Finding relevant indexed code"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Grep|Glob|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "semctl hook",
            "timeout": 6,
            "statusMessage": "Checking semctx retrieval guidance"
          }
        ]
      },
      {
        "matcher": "mcp__semctx__.*",
        "hooks": [
          {
            "type": "command",
            "command": "semctl hook",
            "timeout": 2
          }
        ]
      }
    ]
  }
}
